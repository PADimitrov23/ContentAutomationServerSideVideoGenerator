GEMINI_API_KEY=your_gemini_api_key
PEXELS_API_KEY=your_pexels_api_key

# Optional: override the Gemini model used by modules/brain.py
GEMINI_MODEL=gemini-2.0-flash

# Error alerts — Discord webhook (direct, simplest)
# Create one in Discord: channel settings -> Integrations -> Webhooks
# Example: https://discord.com/api/webhooks/123456789/abcdef
DISCORD_WEBHOOK_URL=

# OR n8n webhook for error alerts (server -> n8n -> Telegram/Discord/etc)
# Example: http://192.168.1.60:5678/webhook/shorts-alert
N8N_WEBHOOK_URL=
